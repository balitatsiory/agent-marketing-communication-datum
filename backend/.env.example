# Copier en .env et remplacer les valeurs. .env n'est JAMAIS versionné.

# ---------------------------------------------------------------------------
# Environnement : local | test | production
# ---------------------------------------------------------------------------
ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# La base tourne en conteneur (docker compose up -d db) sur le port 5433 :
# le PostgreSQL installé sur le poste occupe déjà 5432.
#
# L'URL nomme TOUJOURS son pilote. Depuis SQLAlchemy 2.1, une URL écrite
# « postgresql:// » sans pilote utilise psycopg 3 et non asyncpg.
#
# 127.0.0.1 et non « localhost » : sous Windows, localhost résout d'abord
# vers ::1 (IPv6), alors que le conteneur ne publie son port que sur
# 127.0.0.1 (IPv4). Avec « localhost », la connexion peut être refusée
# alors que la base tourne.
DATABASE_URL=postgresql+asyncpg://iagora:iagora@127.0.0.1:5433/iagora

# Base utilisée par pytest. Elle est remise à zéro à chaque exécution :
# ne jamais y mettre de données de travail.
TEST_DATABASE_URL=postgresql+asyncpg://iagora:iagora@127.0.0.1:5433/iagora_test

# ---------------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------------
# Signature des jetons.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=a-remplacer-par-une-cle-aleatoire

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Chiffrement des secrets de plateformes conservés en base (Fernet).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=a-remplacer-par-une-cle-fernet

# ---------------------------------------------------------------------------
# Interface web
# ---------------------------------------------------------------------------
# Origines autorisées à appeler l'API, séparées par des virgules.
# 4200 est le port par défaut de « ng serve ».
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ---------------------------------------------------------------------------
# Stockage des médias
# ---------------------------------------------------------------------------
# « local » écrit dans un dossier du poste : mode du développement et des
# tests, pour que la suite ne dépende ni du réseau ni d'identifiants
# Cloudflare. « r2 » est le mode réel.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/medias

# Cloudflare R2. Les quatre valeurs sont exigées au démarrage dès que
# STORAGE_BACKEND vaut « r2 » : mieux vaut échouer là qu'au premier dépôt.
# Les créer dans le tableau de bord Cloudflare, section R2, puis
# « Manage R2 API Tokens » — un jeton d'API S3, pas un jeton de compte.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Domaine public du seau. La conception sert les médias par URL publique :
# aucune signature n'est nécessaire en lecture, et la base ne garde que la
# clé de l'objet — jamais l'URL, qui change de domaine ou expire.
R2_PUBLIC_BASE_URL=

# Limites, reprises du document d'architecture v1.4 du 21/10/2026.
# 8 Mo est le plafond de ce qui est RANGÉ : au-delà, l'image est compressée
# pour y revenir, elle n'est pas refusée.
MEDIA_MAX_STORED_BYTES=8388608
# Garde-fou de SOUMISSION : au-delà, le dépôt est interrompu en cours de
# lecture, sans être transféré en entier.
MEDIA_MAX_UPLOAD_BYTES=52428800
MEDIA_MAX_PIXELS=36000000
