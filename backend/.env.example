# Copier en .env et remplacer les valeurs. .env n'est JAMAIS versionné.

# ---------------------------------------------------------------------------
# Environnement : local | test | production
# ---------------------------------------------------------------------------
ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# La base tourne en conteneur (docker compose up -d db) sur le port 5433 :
# le PostgreSQL installé sur le poste occupe déjà 5432.
#
# L'URL nomme TOUJOURS son pilote. Depuis SQLAlchemy 2.1, une URL écrite
# « postgresql:// » sans pilote utilise psycopg 3 et non asyncpg.
#
# 127.0.0.1 et non « localhost » : sous Windows, localhost résout d'abord
# vers ::1 (IPv6), alors que le conteneur ne publie son port que sur
# 127.0.0.1 (IPv4). Avec « localhost », la connexion peut être refusée
# alors que la base tourne.
DATABASE_URL=postgresql+asyncpg://iagora:iagora@127.0.0.1:5433/iagora

# Base utilisée par pytest. Elle est remise à zéro à chaque exécution :
# ne jamais y mettre de données de travail.
TEST_DATABASE_URL=postgresql+asyncpg://iagora:iagora@127.0.0.1:5433/iagora_test

# ---------------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------------
# Signature des jetons.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=a-remplacer-par-une-cle-aleatoire

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Chiffrement des secrets de plateformes conservés en base (Fernet).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=a-remplacer-par-une-cle-fernet

# ---------------------------------------------------------------------------
# Interface web
# ---------------------------------------------------------------------------
# Origines autorisées à appeler l'API, séparées par des virgules.
# 4200 est le port par défaut de « ng serve ».
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
