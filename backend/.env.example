# Copier ce fichier en .env et remplacer les valeurs.
# .env n'est JAMAIS versionné : il contient des secrets.

# ---------------------------------------------------------------------------
# Environnement
# ---------------------------------------------------------------------------
# local | test | production
ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# --- Exécution en local (mode actuel) ---
# PostgreSQL installé sur le poste, port 5432, base créée à la main :
#   psql -U postgres -c 'CREATE USER iagora WITH PASSWORD ...'
#                    -c 'CREATE DATABASE "stage_iagora" OWNER iagora;'
DATABASE_URL=postgresql+asyncpg://iagora:iagora@localhost:5432/stage_iagora

# Base utilisée par pytest. Elle est vidée à chaque exécution : ne jamais y mettre
# la base de travail.
TEST_DATABASE_URL=postgresql+asyncpg://iagora:iagora@localhost:5432/stage_iagora_test

# --- Exécution en conteneur (plus tard) ---
# Décommenter ces trois lignes et remplacer DATABASE_URL par la variante Docker :
# POSTGRES_USER=iagora
# POSTGRES_PASSWORD=iagora
# POSTGRES_DB=iagora
# DATABASE_URL=postgresql+asyncpg://iagora:iagora@postgres:5432/iagora

# ---------------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------------
# Clé de signature des jetons de session.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=a-remplacer-par-une-cle-aleatoire

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Clé de chiffrement des jetons Meta conservés en base (Fernet).
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=a-remplacer-par-une-cle-fernet

# ---------------------------------------------------------------------------
# Interface web
# ---------------------------------------------------------------------------
# Origines autorisées à appeler l'API, séparées par des virgules.
CORS_ORIGINS=http://localhost:8123,http://127.0.0.1:8123

# ---------------------------------------------------------------------------
# Réseaux sociaux
# ---------------------------------------------------------------------------
# n8n en test, meta en production.
SOCIAL_GATEWAY=n8n

# Utilisé quand SOCIAL_GATEWAY=n8n.
# n8n tourne dans une autre pile Docker : on passe donc par l'hôte.
# (Docker Desktop résout host.docker.internal ; sous Linux, utiliser l'IP de l'hôte.)
N8N_BASE_URL=http://host.docker.internal:5678

# Utilisé quand SOCIAL_GATEWAY=meta
META_API_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
# Jeton de vérification des webhooks Meta (choisi librement, à recopier dans l'app Meta)
META_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Intelligence artificielle (étape ultérieure)
# ---------------------------------------------------------------------------
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
