      "id": "55555555-5555-4555-8555-555555555555",
      "name": "Webhook Evenements (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, 140],
      "webhookId": "55555555-5555-4555-8555-555555555555"
    },
    {
      "parameters": {
        "jsCode": "// Aplatit le payload Meta en un item par evenement de messagerie.\n// Structure recue : { object: 'page'|'instagram', entry: [ { id, time, messaging: [...] } ] }\nconst out = [];\n\nfor (const item of $input.all()) {\n  const body = item.json.body ?? item.json;\n  const platform = body.object; // 'page' (Messenger) ou 'instagram'\n\n  for (const entry of body.entry ?? []) {\n    // Messenger et Instagram utilisent 'messaging'.\n    // Les changements de Page (commentaires, etc.) arrivent dans 'changes'.\n    for (const ev of entry.messaging ?? []) {\n      out.push({\n        json: {\n          platform,\n          // ID de la Page (Messenger) ou de l'IG User (Instagram) : c'est l'expediteur de la reponse\n          accountId: entry.id,\n          senderId: ev.sender?.id ?? null,\n          recipientId: ev.recipient?.id ?? null,\n          timestamp: ev.timestamp ?? null,\n          mid: ev.message?.mid ?? null,\n          text: ev.message?.text ?? null,\n          attachments: ev.message?.attachments ?? [],\n          // is_echo = message envoye PAR la page : ne jamais y repondre (boucle infinie)\n          isEcho: ev.message?.is_echo === true,\n          postback: ev.postback?.payload ?? null,\n          raw: ev\n        }\n      });\n    }\n  }\n}\n\nreturn out;"
      },
      "id": "66666666-6666-4666-8666-666666666666",
      "name": "Normaliser les evenements",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-140, 140]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "not-echo",
              "leftValue": "={{ $json.isEcho }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "false", "singleValue": true }
            },
            {
              "id": "has-text",
              "leftValue": "={{ $json.text }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "77777777-7777-4777-8777-777777777777",
      "name": "Ignorer echos et vides",
      "type": "n8n-nodes-base.filter",
